For this project we use this table

CREATE TABLE BIT_DB.Spotifydata (
id integer PRIMARY KEY,
artist_name varchar NOT NULL,
track_name varchar NOT NULL,
track_id varchar NOT NULL,
popularity integer NOT NULL,
danceability decimal(4,3) NOT NULL,
energy decimal(4,3) NOT NULL,
song_key integer NOT NULL,
loudness decimal(5,3) NOT NULL,
song_mode integer NOT NULL,
speechiness decimal(5,4) NOT NULL,
acousticness decimal(6,5) NOT NULL,
instrumentalness decimal(8,7) NOT NULL,
liveness decimal(5,4) NOT NULL,
valence decimal(4,3) NOT NULL,
tempo decimal(6,3) NOT NULL,
duration_ms integer NOT NULL,
time_signature integer NOT NULL );

SELECT *
FROM BIT_DB.Spotifydata;

-- Who are the top 10 artists based on popularity?

SELECT artist_name
, ROUND(AVG(popularity),2) as avg_popularity
FROM BIT_DB.Spotifydata
GROUP BY artist_name
ORDER BY avg_popularity desc
LIMIT 10;

-- Top Popular Tracks: Retrieve the top 10 tracks with the highest popularity score.

SELECT artist_name
, track_name
, popularity
FROM BIT_DB.Spotifydata
ORDER BY popularity desc
LIMIT 10;

-- Average Danceability by Artist: Find the average danceability score for each artist. List the artist name and the average danceability, ordered by the highest average first.

SELECT artist_name, ROUND(AVG(danceability)*100,2) as avg_dance
FROM BIT_DB.Spotifydata
GROUP BY artist_name
ORDER BY avg_dance DESC;

-- Tracks Longer Than 4 Minutes:

SELECT track_name, duration_ms
FROM BIT_DB.Spotifydata
WHERE duration_ms > 240000;

-- Tracks with High Energy and Valence:

SELECT track_name, energy, valence
FROM BIT_DB.Spotifydata
WHERE energy >= 0.7
AND valence >= 0.7;

-- Distinct Keys Used:

SELECT song_key, Count(song_key)
FROM BIT_DB.Spotifydata
GROUP BY song_key;

-- Most Common Time Signature:

SELECT time_signature, COUNT(time_signature) as COUNT_ts
FROM BIT_DB.Spotifydata
GROUP BY time_signature
ORDER BY COUNT_ts DESC
LIMIT 1;

-- Top 5 Loudest Tracks:

SELECT track_name, ROUND(loudness,2)
FROM BIT_DB.Spotifydata
ORDER BY loudness DESC
LIMIT 5;

-- Tracks with Speechiness Between 0.03 and 0.07

SELECT artist_name, track_name, ROUND(speechiness,2)
FROM BIT_DB.Spotifydata
WHERE speechiness >= 0.03 AND speechiness <= 0.07
ORDER BY speechiness DESC;

-- Instrumental Tracks. List the tracks with an instrumentalness score greater than 0.01. Include the track name and artist.

SELECT artist_name track_name, instrumentalness
FROM BIT_DB.Spotifydata
WHERE instrumentalness > 0.01
ORDER BY instrumentalness DESC;

-- Valence and Tempo Relationship. Calculate the average tempo for tracks with a valence greater than 0.5 and compare it to the average tempo of tracks with a valence less than 0.5.(Review)
SELECT AVG(tempo), valence
FROM BIT_DB.Spotifydata
WHERE valence > 0.5; 

SELECT AVG(tempo), valence
FROM BIT_DB.Spotifydata
WHERE valence < 0.5;

-- What artist released the longest song?

SELECT artist_name, track_name, MAX(duration_ms)
FROM BIT_DB.Spotifydata;
